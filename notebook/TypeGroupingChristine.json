{
    "name": "TypeGroupingChristine",
    "properties": {
        "nbformat": 4,
        "nbformat_minor": 2,
        "bigDataPool": {
            "referenceName": "darwinsparkpoc",
            "type": "BigDataPoolReference"
        },
        "sessionProperties": {
            "driverMemory": "28g",
            "driverCores": 4,
            "executorMemory": "28g",
            "executorCores": 4,
            "numExecutors": 2,
            "conf": {
                "spark.dynamicAllocation.enabled": "false",
                "spark.dynamicAllocation.minExecutors": "2",
                "spark.dynamicAllocation.maxExecutors": "2",
                "spark.autotune.trackingId": "e0659bf8-8c67-4de8-9c3b-599be2dac10e"
            }
        },
        "metadata": {
            "saveOutput": true,
            "enableDebugMode": false,
            "kernelspec": {
                "name": "synapse_pyspark",
                "display_name": "Synapse PySpark"
            },
            "language_info": {
                "name": "python"
            },
            "a365ComputeOptions": {
                "id": "/subscriptions/199b3c58-a154-4c89-80c8-6bbc39e6bee0/resourceGroups/darwinpoc/providers/Microsoft.Synapse/workspaces/darwinsynapse/bigDataPools/darwinsparkpoc",
                "name": "darwinsparkpoc",
                "type": "Spark",
                "endpoint": "https://darwinsynapse.dev.azuresynapse.net/livyApi/versions/2019-11-01-preview/sparkPools/darwinsparkpoc",
                "auth": {
                    "type": "AAD",
                    "authResource": "https://dev.azuresynapse.net"
                },
                "sparkVersion": "3.4",
                "nodeCount": 3,
                "cores": 4,
                "memory": 28,
                "automaticScaleJobs": false
            },
            "sessionKeepAliveTimeout": 30
        },
        "cells": [
            {
                "cell_type": "code",
                "execution_count": 1,
                "source": [
                    "storage_account_name = \"darwinadls\"\r\n",
                    "container_name = \"darwinfs\"\r\n",
                    "curated_data_path = f\"abfss://{container_name}@{storage_account_name}.dfs.core.windows.net/data/transcripts/curated/\"\r\n",
                    "\r\n",
                    "data = spark.read.parquet(curated_data_path)\r\n"
                ]
            },
            {
                "cell_type": "code",
                "execution_count": 1,
                "source": [
                    "from pyspark.sql.functions import avg\r\n",
                    "\r\n",
                    "\r\n",
                    "df_counts = data.groupBy(\"execution_id\", \"t\").count()\r\n",
                    "df_avg_t = df_counts.groupBy(\"t\").agg(avg(\"count\").alias(\"avg_count_per_execution\"))\r\n",
                    "\r\n",
                    "df_counts.show()\r\n",
                    "df_avg_t.show()\r\n"
                ]
            }
        ]
    }
}