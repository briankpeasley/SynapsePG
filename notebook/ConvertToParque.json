			}
		},
		"metadata": {
			"saveOutput": true,
			"enableDebugMode": false,
			"kernelspec": {
				"name": "synapse_pyspark",
				"display_name": "Synapse PySpark"
			},
			"language_info": {
				"name": "python"
			},
			"a365ComputeOptions": {
				"id": "/subscriptions/199b3c58-a154-4c89-80c8-6bbc39e6bee0/resourceGroups/darwinpoc/providers/Microsoft.Synapse/workspaces/darwinsynapse/bigDataPools/darwinsparkpoc",
				"name": "darwinsparkpoc",
				"type": "Spark",
				"endpoint": "https://darwinsynapse.dev.azuresynapse.net/livyApi/versions/2019-11-01-preview/sparkPools/darwinsparkpoc",
				"auth": {
					"type": "AAD",
					"authResource": "https://dev.azuresynapse.net"
				},
				"sparkVersion": "3.4",
				"nodeCount": 3,
				"cores": 4,
				"memory": 28,
				"automaticScaleJobs": false
			},
			"sessionKeepAliveTimeout": 30
		},
		"cells": [
			{
				"cell_type": "code",
				"source": [
					"# Set your Storage account and container\n",
					"storage_account_name = \"darwinadls\"\n",
					"container_name = \"darwinfs\"\n",
					"\n",
					"# Paths\n",
					"raw_data_path = f\"abfss://{container_name}@{storage_account_name}.dfs.core.windows.net/data/transcripts/\"\n",
					"curated_data_path = f\"abfss://{container_name}@{storage_account_name}.dfs.core.windows.net/data/transcripts/curated/\"\n",
					""
				],
				"execution_count": 4
			},
			{
				"cell_type": "code",
				"source": [
					"df_raw = spark.read.json(raw_data_path)\n",
					"df_raw.show()"
				],
				"execution_count": 8
			},
			{
				"cell_type": "code",
				"source": [
					"# Write out as Parquet to curated path (overwrite mode for dev)\n",
					"df_raw.write.mode(\"overwrite\").parquet(curated_data_path)\n",
					""
				],
				"execution_count": 9
			},
			{
				"cell_type": "code",
				"source": [
					"# Read back curated Parquet data\n",
					"df_curated = spark.read.parquet(curated_data_path)\n",
					"\n",
					"# Show final curated data\n",
					"df_curated.show()\n",
					""
				],
				"execution_count": 10
			}
		]
	}
}